# Apache configuration for cPanel / LiteSpeed
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS Redirection (Optional but recommended for SEO)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # If requested resource exists as a directory or file, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback for SPA routing to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# UTF-8 Encoding for Japanese Characters
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json

# Enable Compression for SEO Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
